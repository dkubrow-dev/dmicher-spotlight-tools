<form class="dmicher-request-settings-form">
  <section>
    <p class="dmicher-settings-intro">{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.Intro"}}</p>
    <div class="dmicher-settings-blocks">
      {{#each requests}}
      <fieldset class="dmicher-settings-block dmicher-settings-{{urgency}}" {{disabledText}}>
        <legend>{{label}}</legend>
        {{#if forbiddenHint}}<p class="notification warning">{{forbiddenHint}}</p>{{/if}}
        <div class="dmicher-settings-preview">
          <div class="dmicher-request-image-frame">
            <img class="dmicher-settings-image" src="{{image}}" alt="{{imageAlt}}"
              title="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.ImageTitle'}}"
              data-request-image data-urgency="{{urgency}}" data-disabled="{{disabled}}"
              role="button" tabindex="0" draggable="true">
            {{#if timeoutActive}}
            <span class="dmicher-request-timeout-countdown" data-request-timeout-countdown
              data-request-timeout-expires-at="{{timeoutExpiresAt}}" role="timer"
              title="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Limits.TimeoutNotice'}}">{{timeoutRemainingText}}</span>
            {{/if}}
          </div>
          <span class="dmicher-hotbar-macro-hint">{{localize "DMICHERSPOTLIGHTTOOLS.Hints.ClickOrDragHotbarMacro"}}</span>
        </div>
        <label class="dmicher-settings-field">
          <span>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.Text"}}</span>
          <textarea name="{{urgency}}Text" rows="3" maxlength="500" placeholder="{{placeholder}}" {{disabledText}}>{{text}}</textarea>
        </label>
        <div class="dmicher-request-appearance">
          <label class="dmicher-settings-field dmicher-request-color-field">
            <span>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.Color"}}</span>
            <span class="dmicher-request-color-controls">
              <input type="color" name="{{urgency}}ColorPicker" value="{{color}}"
                data-request-color-picker data-urgency="{{urgency}}"
                aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.ColorPicker'}}">
              <input type="text" name="{{urgency}}Color" value="{{color}}" maxlength="7"
                pattern="#[0-9a-fA-F]{6}" required spellcheck="false" autocomplete="off"
                data-request-color-field data-urgency="{{urgency}}"
                aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.ColorValue'}}">
            </span>
          </label>

          <fieldset class="dmicher-request-font-settings">
            <legend>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.Font"}}</legend>
            <label class="dmicher-settings-field dmicher-request-font-size">
              <span>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.FontSize"}}</span>
              <input type="text" name="{{urgency}}FontSize" value="{{fontSize}}" maxlength="100" required>
            </label>
            <div class="dmicher-request-font-toggles" role="group"
              aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.FontDecorations'}}">
              <input type="hidden" name="{{urgency}}Underline" value="{{#if underline}}true{{else}}false{{/if}}">
              <button type="button" class="dmicher-font-toggle dmicher-font-underline {{#if underline}}active{{/if}}"
                data-request-font-toggle="Underline" data-urgency="{{urgency}}"
                aria-pressed="{{#if underline}}true{{else}}false{{/if}}"
                aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.Underline'}}"
                title="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.Underline'}}">u</button>
              <input type="hidden" name="{{urgency}}Italic" value="{{#if italic}}true{{else}}false{{/if}}">
              <button type="button" class="dmicher-font-toggle dmicher-font-italic {{#if italic}}active{{/if}}"
                data-request-font-toggle="Italic" data-urgency="{{urgency}}"
                aria-pressed="{{#if italic}}true{{else}}false{{/if}}"
                aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.Italic'}}"
                title="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.Italic'}}">i</button>
              <input type="hidden" name="{{urgency}}Bold" value="{{#if bold}}true{{else}}false{{/if}}">
              <button type="button" class="dmicher-font-toggle dmicher-font-bold {{#if bold}}active{{/if}}"
                data-request-font-toggle="Bold" data-urgency="{{urgency}}"
                aria-pressed="{{#if bold}}true{{else}}false{{/if}}"
                aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.Bold'}}"
                title="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Settings.Bold'}}">b</button>
            </div>
          </fieldset>

          <label class="dmicher-settings-field dmicher-request-alignment-field">
            <span>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.Alignment"}}</span>
            <select name="{{urgency}}Alignment">
              <option value="center" {{#if alignCenter}}selected{{/if}}>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.AlignCenter"}}</option>
              <option value="left" {{#if alignLeft}}selected{{/if}}>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.AlignLeft"}}</option>
              <option value="right" {{#if alignRight}}selected{{/if}}>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.AlignRight"}}</option>
            </select>
          </label>
        </div>
      </fieldset>
      {{/each}}
    </div>
  </section>


  <footer class="form-footer">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Settings.Save"}}
    </button>
  </footer>
</form>

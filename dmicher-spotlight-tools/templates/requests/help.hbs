<div class="dmicher-request-help-layout">
  <nav class="dmicher-request-help-toc" aria-label="{{localize 'DMICHERSPOTLIGHTTOOLS.Requests.Help.Contents'}}">
    <h2>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Help.Contents"}}</h2>
    {{#each groups}}
    <section class="dmicher-request-help-group {{#if active}}active{{/if}}" data-help-group="{{id}}">
      <h3>{{title}}</h3>
      {{#each pages}}
      <button type="button" class="dmicher-help-page-link {{#if active}}active{{/if}}" data-help-page="{{id}}">
        {{title}}
      </button>
      {{/each}}
    </section>
    {{/each}}
  </nav>
  <article class="dmicher-request-help-page">
    <h2>{{pageTitle}}</h2>
    <p class="dmicher-request-help-intro">{{pageIntro}}</p>
    <div class="dmicher-request-help-sections">
      {{#each pageSections}}
      <section class="dmicher-request-help-section">
        <h3>{{title}}</h3>
        <dl>
          {{#each items}}
          <div class="dmicher-request-help-item">
            <dt>{{label}}</dt>
            <dd>{{description}}</dd>
          </div>
          {{/each}}
        </dl>
      </section>
      {{/each}}
    </div>
    {{#if showRequestActions}}
    <div class="dmicher-request-help-actions">
      <button type="button" data-help-action="settings">
        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Help.OpenSettings"}}
      </button>
      <button type="button" data-help-action="management">
        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
        {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Help.OpenManagement"}}
      </button>
    </div>
    {{/if}}
  </article>
</div>

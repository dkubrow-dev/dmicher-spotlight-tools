<section class="dmicher-active-requests-shell">
  <h2 class="dmicher-tool-window-heading">{{localize keys.heading}}</h2>
  <div class="dmicher-active-request-filters">
    <fieldset>
      <legend>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Active.Filters.Type"}}</legend>
      {{#each typeFilters}}
      <label><input type="checkbox" value="{{type}}" data-active-request-filter="type" {{#if checked}}checked{{/if}}> {{label}}</label>
      {{/each}}
    </fieldset>
    <fieldset>
      <legend>{{localize "DMICHERSPOTLIGHTTOOLS.Requests.Active.Filters.Duplicates"}}</legend>
      <label><input type="radio" name="duplicates" value="none" data-active-request-filter="duplicates" {{#if duplicateNone}}checked{{/if}}> {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Active.Filters.None"}}</label>
      <label><input type="radio" name="duplicates" value="type" data-active-request-filter="duplicates" {{#if duplicateType}}checked{{/if}}> {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Active.Filters.ByType"}}</label>
      <label><input type="radio" name="duplicates" value="player" data-active-request-filter="duplicates" {{#if duplicatePlayer}}checked{{/if}}> {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Active.Filters.ByPlayer"}}</label>
    </fieldset>
  </div>
  <p class="dmicher-active-requests-summary">{{summaryText}} &mdash; {{localize "DMICHERSPOTLIGHTTOOLS.Requests.Active.Visible"}}: <span data-visible-request-count>{{totalCount}}</span></p>

  <div class="dmicher-tool-table-scroll dmicher-active-requests-table-wrap">
    {{#if hasRequests}}
    <table class="dmicher-tool-table dmicher-active-requests-table">
      <thead>
        <tr>
          <th>{{localize keys.columnIcon}}</th>
          <th>{{localize keys.columnSubmitted}}</th>
          <th>{{localize keys.columnAuthor}}</th>
          <th class="dmicher-tool-row-actions-heading">{{localize keys.columnControls}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each requests}}
        <tr data-active-request-row data-request-id="{{id}}" data-author-id="{{authorId}}" data-urgency="{{urgency}}">
          <td class="dmicher-active-request-type">
            <div class="dmicher-active-request-images">
              <img src="{{portrait}}" alt="{{authorName}}" title="{{authorName}}">
              <img src="{{image}}" alt="{{typeLabel}}" title="{{typeLabel}}">
            </div>
          </td>
          <td>{{submittedText}}</td>
          <td>{{authorText}}</td>
          <td class="dmicher-tool-row-actions">
            {{#if hasChatMessage}}
            <button type="button" data-active-request-action="open" data-request-id="{{id}}" title="{{localize ../keys.openMessage}}">
              <i class="fa-solid fa-eye" aria-hidden="true"></i>
            </button>
            {{/if}}
            <button type="button" data-active-request-action="grant" data-request-id="{{id}}" title="{{grantLabel}}">
              <i class="fa-solid fa-comment" aria-hidden="true"></i>
            </button>
            <button type="button" data-active-request-action="cancel" data-request-id="{{id}}" title="{{localize ../keys.cancel}}">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="notes dmicher-active-requests-empty">{{localize keys.empty}}</p>
    {{/if}}
  </div>

  <footer class="dmicher-active-requests-footer">
    {{#if showResetTimeouts}}
    <button type="button" data-active-request-action="reset-timeouts">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
      {{localize keys.resetTimeouts}}
    </button>
    {{/if}}
    <button type="button" data-active-request-action="environment">
      <i class="fa-solid fa-mountain-sun" aria-hidden="true"></i>
      {{localize keys.environment}}
    </button>
    <button type="button" data-active-request-action="clear">
      <i class="fa-solid fa-trash" aria-hidden="true"></i>
      {{localize keys.clear}}
    </button>
  </footer>
</section>
